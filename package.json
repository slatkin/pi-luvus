{
  "name": "pi-luvus",
  "version": "0.1.0",
  "description": "pi integration for Luvus: subagents in panes, live agent status, Luvus bar and notifications",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "pi-extension/",
    "agents/",
    "skills/",
    "luvus-module/",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "slatkin",
  "repository": {
    "type": "git",
    "url": "https://github.com/slatkin/pi-luvus"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/luvus/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.49",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
